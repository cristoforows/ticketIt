; npm's default for a local "file:" dependency is a symlink into the
; target directory. That breaks this package's own ESM resolution of
; opencode-harness's transitive dependencies (@opencode-ai/sdk,
; opencode-ai): Node resolves a symlinked module's imports from its
; *real* path, so it looks for node_modules starting at
; experiments/opencode-harness/ (which this package must never write
; into -- two other slices install into that shared package
; concurrently) instead of experiments/opencode-fixed-inputs/node_modules
; (which already has @opencode-ai/sdk/opencode-ai as this package's own
; direct dependencies, pinned to the same exact version). install-links
; makes npm copy the local dependency into this package's own
; node_modules instead, so resolution climbs into this package's own
; node_modules and succeeds, and npm never touches
; experiments/opencode-harness/ at all (read-only tarball-style copy).
install-links=true
